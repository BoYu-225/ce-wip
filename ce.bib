@misc{team_kimi_2026,
	title = {Kimi {K3}: {Open} {Frontier} {Intelligence}},
	shorttitle = {Kimi {K3}},
	url = {http://arxiv.org/abs/2607.24653},
	doi = {10.48550/arXiv.2607.24653},
	abstract = {We introduce Kimi K3, a 2.8T parameter Mixture-of-Experts model with 104 billion activated parameters, native vision capabilities, and a 1-million-token context window. Kimi K3 is built on Kimi Delta Attention and Attention Residuals, which improve information flow across sequence length and model depth. Together with Stable LatentMoE, which effectively activates 16 of 896 routed experts per token, and refined training and data recipes, these advances yield an approximately 2.5x improvement in overall scaling efficiency over Kimi K2. Post-training highlights reinforcement learning across general, agentic, and coding domains and multiple reasoning-effort levels, enabling compositional generalization and robust long-horizon execution. At 2.8T scale, Kimi K3 is supported by infrastructure advances in multiple areas: algorithm-system co-design for KDA, perfectly balanced expert-parallel training with efficient memory management, million-token agentic RL with persistent rollout and sandbox states, and deployment innovations. Extensive evaluations show that Kimi K3 achieves frontier-level performance across long-horizon coding, agentic, knowledge, reasoning, and vision tasks. While its overall performance still trails the most powerful proprietary models, namely Claude Fable 5 and GPT-5.6 Sol, Kimi K3 consistently outperforms other open and proprietary models evaluated in our suite. We release the full Kimi K3 model weights to facilitate future research and accelerate the broader deployment and adoption of frontier intelligence.},
	urldate = {2026-08-05},
	publisher = {arXiv},
	author = {Team, Kimi and Bai, Tongtong and Bai, Yifan and Bao, Yiping and C, M. and Cai, Jianfeng and Cai, Xinyuan and Cao, Peizhou and Cao, Yuxuan and Chai, Ziwei and Charles, Y. and Che, H. S. and Chen, Guanduo and Chen, Guangyu and Chen, Guanzheng and Chen, Huarong and Chen, Jia and Chen, Jianlong and Chen, Jun and Chen, Kexin and Chen, Peng and Chen, Ruijue and Chen, Wentao and Chen, Xin and Chen, Yang and Chen, Yanru and Chen, Yifei and Chen, Yingjiang and Chen, Yuankun and Chen, Yujie and Chen, Yutian and Chen, Zhirong and Cheng, Dazhi and Cheng, Yean and Cui, Jialei and Cui, Jingbing and Dai, Anqi and Deng, Jiaqi and Ding, Hao and Ding, Rui and Ding, Shaofeng and Dong, Mengfan and Dong, Mengnan and Dong, Yuhao and Dong, Yuxin and Du, Angang and Du, Chenzhuang and Du, Dikang and Du, Jusen and Du, Yulun and Fan, Yu and Feng, Jing and Feng, Qiulin and Feng, Yichen and Fu, Kelin and Fu, Qiang and Gao, Fuxuan and Gao, Hongcheng and Gao, Jingyue and Gao, Tong and Gao, Weijia and Geng, Shangyi and Gong, Jie and Gong, Linhu and Gong, Shengao and Gong, Xiaochen and Gu, Qizheng and Gu, Yicheng and Guan, Shuhao and Guo, Haiqing and Guo, Shiqi and Guo, Xiang and Guo, Zhengyan and Hao, Beixi and Hao, Wenxin and Hao, Xiaoru and He, Dailan and He, Haotian and He, Lehan and He, Qi and He, Weiran and He, Xinran and He, Xinyi and He, Yibo and He, Yunjia and Hong, Chao and Hong, Tiange and Hu, Hao and Hu, Jiaxi and Hu, Ruikun and Hu, Weiming and Hu, Yangyang and Hu, Zhenxing and Hua, Liang and Huang, Jinbin and Huang, Ke and Huang, Ruiyuan and Huang, Siying and Huang, Weixiao and Huang, Yan and Huang, Zhengjie and Huang, Zhiqi and Hui, Yulong and Jia, Chaobo and Jiang, Yutong and Jiang, Zhejun and Jiang, Zuoyou and Jin, Wenyi and Jin, Xinyi and Jing, Yu and Kong, Huanjun and Lai, Guokun and Li, Aidi and Li, Cheng and Li, Chengyuan and Li, Cong and Li, Fang and Li, Guanyu and Li, Haoyang and Li, Jia and Li, Junxiong and Li, Lei and Li, Letian and Li, Lincan and Li, Weihong and 